package com.deelip.assistant;

import android.app.Activity;
import android.app.AlertDialog;
import android.content.Context;
import android.content.DialogInterface;
import android.content.Intent;
import android.content.IntentFilter;
import android.content.pm.PackageManager;
import android.content.pm.ResolveInfo;
import android.database.Cursor;
import android.hardware.camera2.CameraManager;
import android.media.AudioManager;
import android.net.Uri;
import android.os.Build;
import android.os.Bundle;
import android.provider.AlarmClock;
import android.provider.ContactsContract;
import android.provider.Settings;
import android.speech.RecognizerIntent;
import android.speech.tts.TextToSpeech;
import android.telecom.TelecomManager;
import android.telephony.SmsManager;
import android.webkit.JavascriptInterface;
import android.webkit.JsPromptResult;
import android.webkit.JsResult;
import android.webkit.WebChromeClient;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import android.widget.EditText;
import java.io.ByteArrayOutputStream;
import java.io.InputStream;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.util.ArrayList;
import java.util.List;
import java.util.Locale;
import org.json.JSONObject;

public class MainActivity extends Activity {
    WebView w;
    TextToSpeech tts;

    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        tts = new TextToSpeech(this, new TextToSpeech.OnInitListener() {
            public void onInit(int st) {
                if (st == TextToSpeech.SUCCESS) tts.setLanguage(new Locale("hi", "IN"));
            }
        });
        w = new WebView(this);
        WebSettings s = w.getSettings();
        s.setJavaScriptEnabled(true);
        s.setDomStorageEnabled(true);
        w.setWebViewClient(new WebViewClient());
        w.setWebChromeClient(new WebChromeClient() {
            @Override
            public boolean onJsConfirm(WebView v, String u, String m, final JsResult r) {
                new AlertDialog.Builder(MainActivity.this).setMessage(m).setCancelable(false)
                    .setPositiveButton("हाँ", new DialogInterface.OnClickListener() {
                        public void onClick(DialogInterface d, int i) { r.confirm(); }
                    })
                    .setNegativeButton("नहीं", new DialogInterface.OnClickListener() {
                        public void onClick(DialogInterface d, int i) { r.cancel(); }
                    }).show();
                return true;
            }
            @Override
            public boolean onJsPrompt(WebView v, String u, String m, String def, final JsPromptResult r) {
                final EditText et = new EditText(MainActivity.this);
                et.setText(def);
                new AlertDialog.Builder(MainActivity.this).setMessage(m).setView(et).setCancelable(false)
                    .setPositiveButton("ठीक है", new DialogInterface.OnClickListener() {
                        public void onClick(DialogInterface d, int i) { r.confirm(et.getText().toString()); }
                    })
                    .setNegativeButton("रद्द", new DialogInterface.OnClickListener() {
                        public void onClick(DialogInterface d, int i) { r.cancel(); }
                    }).show();
                return true;
            }
        });
        w.addJavascriptInterface(new Bridge(), "Android");
        setContentView(w);
        if (Build.VERSION.SDK_INT >= 23) {
            requestPermissions(new String[]{
                "android.permission.CALL_PHONE", "android.permission.SEND_SMS",
                "android.permission.READ_CONTACTS", "android.permission.ANSWER_PHONE_CALLS",
                "android.permission.READ_PHONE_STATE"}, 1);
        }
        w.loadUrl("file:///android_asset/index.html");
    }

    @Override
    protected void onActivityResult(int req, int res, Intent data) {
        super.onActivityResult(req, res, data);
        if (req == 1 && res == RESULT_OK && data != null) {
            ArrayList<String> r = data.getStringArrayListExtra(RecognizerIntent.EXTRA_RESULTS);
            if (r != null && r.size() > 0)
                w.evaluateJavascript("onSpeech(" + JSONObject.quote(r.get(0)) + ")", null);
        }
    }

    void go(Intent i) {
        i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
        startActivity(i);
    }

    class Bridge {
        @JavascriptInterface
        public void speak(String t) {
            if (tts != null) tts.speak(t, TextToSpeech.QUEUE_FLUSH, null);
        }

        @JavascriptInterface
        public void listen() {
            runOnUiThread(new Runnable() {
                public void run() {
                    Intent i = new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH);
                    i.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM);
                    i.putExtra(RecognizerIntent.EXTRA_LANGUAGE, "hi-IN");
                    try { startActivityForResult(i, 1); } catch (Exception e) {}
                }
            });
        }

        @JavascriptInterface
        public void ask(final String key, final String body) {
            new Thread(new Runnable() {
                public void run() {
                    String out;
                    try {
                        URL u = new URL("https://api.anthropic.com/v1/messages");
                        HttpURLConnection c = (HttpURLConnection) u.openConnection();
                        c.setRequestMethod("POST");
                        c.setRequestProperty("content-type", "application/json");
                        c.setRequestProperty("x-api-key", key);
                        c.setRequestProperty("anthropic-version", "2023-06-01");
                        c.setDoOutput(true);
                        c.setConnectTimeout(20000);
                        c.setReadTimeout(90000);
                        OutputStream os = c.getOutputStream();
                        os.write(body.getBytes("UTF-8"));
                        os.close();
                        int code = c.getResponseCode();
                        InputStream is = code >= 400 ? c.getErrorStream() : c.getInputStream();
                        ByteArrayOutputStream bo = new ByteArrayOutputStream();
                        byte[] buf = new byte[4096];
                        int n;
                        while ((n = is.read(buf)) > 0) bo.write(buf, 0, n);
                        out = bo.toString("UTF-8");
                    } catch (Exception e) {
                        out = "{\"error\":{\"message\":\"" + String.valueOf(e.getMessage()).replace("\"", "'") + "\"}}";
                    }
                    final String res = out;
                    runOnUiThread(new Runnable() {
                        public void run() {
                            w.evaluateJavascript("onReply(" + JSONObject.quote(res) + ")", null);
                        }
                    });
                }
            }).start();
        }

        @JavascriptInterface
        public String run(String name, String args) {
            try {
                JSONObject a = new JSONObject(args);
                if (name.equals("call_phone")) {
                    go(new Intent(Intent.ACTION_CALL, Uri.parse("tel:" + a.getString("number"))));
                    return "कॉल लगा दी";
                }
                if (name.equals("send_sms")) {
                    SmsManager sm = SmsManager.getDefault();
                    ArrayList<String> parts = sm.divideMessage(a.getString("text"));
                    sm.sendMultipartTextMessage(a.getString("number"), null, parts, null, null);
                    return "SMS भेज दिया";
                }
                if (name.equals("find_contact")) {
                    Cursor c = getContentResolver().query(
                        ContactsContract.CommonDataKinds.Phone.CONTENT_URI,
                        new String[]{ContactsContract.CommonDataKinds.Phone.DISPLAY_NAME, ContactsContract.CommonDataKinds.Phone.NUMBER},
                        ContactsContract.CommonDataKinds.Phone.DISPLAY_NAME + " LIKE ?",
                        new String[]{"%" + a.getString("name") + "%"}, null);
                    StringBuilder sb = new StringBuilder();
                    int n = 0;
                    while (c != null && c.moveToNext() && n < 5) {
                        sb.append(c.getString(0)).append(": ").append(c.getString(1)).append("\n");
                        n++;
                    }
                    if (c != null) c.close();
                    return sb.length() == 0 ? "कोई कॉन्टैक्ट नहीं मिला" : sb.toString();
                }
                if (name.equals("open_app")) {
                    String q = a.getString("name").toLowerCase();
                    PackageManager pm = getPackageManager();
                    Intent main = new Intent(Intent.ACTION_MAIN, null);
                    main.addCategory(Intent.CATEGORY_LAUNCHER);
                    List<ResolveInfo> l = pm.queryIntentActivities(main, 0);
                    for (ResolveInfo r : l) {
                        String lb = r.loadLabel(pm).toString().toLowerCase();
                        if (lb.contains(q)) {
                            Intent i = pm.getLaunchIntentForPackage(r.activityInfo.packageName);
                            if (i != null) { go(i); return "खोल दिया: " + lb; }
                        }
                    }
                    return "ऐप नहीं मिला";
                }
                if (name.equals("open_url")) {
                    go(new Intent(Intent.ACTION_VIEW, Uri.parse(a.getString("url"))));
                    return "लिंक खोल दिया";
                }
                if (name.equals("set_alarm")) {
                    Intent i = new Intent(AlarmClock.ACTION_SET_ALARM);
                    i.putExtra(AlarmClock.EXTRA_HOUR, a.getInt("hour"));
                    i.putExtra(AlarmClock.EXTRA_MINUTES, a.getInt("minute"));
                    i.putExtra(AlarmClock.EXTRA_MESSAGE, a.optString("label", "Alarm"));
                    i.putExtra(AlarmClock.EXTRA_SKIP_UI, true);
                    go(i);
                    return "अलार्म लगा दिया";
                }
                if (name.equals("set_timer")) {
                    Intent i = new Intent(AlarmClock.ACTION_SET_TIMER);
                    i.putExtra(AlarmClock.EXTRA_LENGTH, a.getInt("seconds"));
                    i.putExtra(AlarmClock.EXTRA_SKIP_UI, true);
                    go(i);
                    return "टाइमर चालू";
                }
                if (name.equals("flashlight")) {
                    CameraManager cm = (CameraManager) getSystemService(Context.CAMERA_SERVICE);
                    boolean on = a.optBoolean("on", true);
                    cm.setTorchMode(cm.getCameraIdList()[0], on);
                    return on ? "टॉर्च चालू" : "टॉर्च बंद";
                }
                if (name.equals("set_volume")) {
                    AudioManager am = (AudioManager) getSystemService(Context.AUDIO_SERVICE);
                    int mx = am.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
                    int p = Math.max(0, Math.min(100, a.getInt("percent")));
                    am.setStreamVolume(AudioManager.STREAM_MUSIC, mx * p / 100, 0);
                    return "वॉल्यूम " + p + "%";
                }
                if (name.equals("battery")) {
                    Intent bi = registerReceiver(null, new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
                    int lv = bi.getIntExtra("level", -1), sc = bi.getIntExtra("scale", 100);
                    return "बैटरी " + (lv * 100 / sc) + "%";
                }
                if (name.equals("open_settings")) {
                    String wh = a.optString("which", "general");
                    String act = Settings.ACTION_SETTINGS;
                    if (wh.equals("wifi")) act = Settings.ACTION_WIFI_SETTINGS;
                    else if (wh.equals("bluetooth")) act = Settings.ACTION_BLUETOOTH_SETTINGS;
                    else if (wh.equals("accessibility")) act = Settings.ACTION_ACCESSIBILITY_SETTINGS;
                    else if (wh.equals("notification_access")) act = "android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS";
                    go(new Intent(act));
                    return "सेटिंग खोल दी";
                }
                if (name.equals("read_notifications")) return NotifService.dump();
                if (name.equals("reply_notification")) return NotifService.reply(a.getInt("index"), a.getString("text"));
                if (name.equals("answer_call")) {
                    TelecomManager tm = (TelecomManager) getSystemService(Context.TELECOM_SERVICE);
                    tm.acceptRingingCall();
                    return "कॉल उठा ली";
                }
                if (name.equals("end_call")) {
                    TelecomManager tm = (TelecomManager) getSystemService(Context.TELECOM_SERVICE);
                    return tm.endCall() ? "कॉल काट दी" : "कॉल नहीं कटी";
                }
                if (name.equals("read_screen")) return PhoneService.read();
                if (name.equals("tap_text")) return PhoneService.tap(a.getString("text"));
                if (name.equals("type_text")) return PhoneService.type(a.getString("text"));
                if (name.equals("press_button")) return PhoneService.press(a.getString("button"));
                if (name.equals("scroll")) return PhoneService.scroll(a.getString("direction"));
                return "अनजान काम: " + name;
            } catch (Exception e) {
                return "एरर: " + e;
            }
        }
    }
}
