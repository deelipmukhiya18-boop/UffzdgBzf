var MODEL='claude-sonnet-5-5';
var SYSTEM='तुम एक मददगार AI असिस्टेंट हो जो यूज़र का Android फ़ोन चला सकता है। हमेशा हिंदी में छोटे और साफ़ जवाब दो। फ़ोन का कोई काम हो तो tools का इस्तेमाल करो। कॉल, SMS और मैसेज के जवाब से पहले ऐप खुद यूज़र से अनुमति माँगता है। किसी ऐप के अंदर काम करना हो तो पहले read_screen से स्क्रीन देखो, फिर tap_text या type_text करो।';
function T(n,d,p){var pr={},rq=[];for(var k in p){pr[k]={type:p[k]==='s'?'string':p[k]==='n'?'number':'boolean'};rq.push(k);}return{name:n,description:d,input_schema:{type:'object',properties:pr,required:rq}};}
var TOOLS=[
T('call_phone','Call a phone number',{number:'s'}),
T('send_sms','Send an SMS',{number:'s',text:'s'}),
T('find_contact','Find phone number of a contact by name',{name:'s'}),
T('open_app','Open an installed app by its name',{name:'s'}),
T('open_url','Open a web URL in the browser',{url:'s'}),
T('set_alarm','Set an alarm, 24 hour clock',{hour:'n',minute:'n',label:'s'}),
T('set_timer','Start a countdown timer',{seconds:'n'}),
T('flashlight','Turn the flashlight on or off',{on:'b'}),
T('set_volume','Set media volume, percent 0 to 100',{percent:'n'}),
T('battery','Get battery percentage',{}),
T('open_settings','Open a settings screen: wifi, bluetooth, accessibility, notification_access or general',{which:'s'}),
T('read_notifications','List recent notifications with index numbers',{}),
T('reply_notification','Reply to a notification by its index',{index:'n',text:'s'}),
T('answer_call','Answer the ringing call',{}),
T('end_call','End the current call',{}),
T('read_screen','Read the text visible on the current screen',{}),
T('tap_text','Tap a button or item on the screen by its text',{text:'s'}),
T('type_text','Type text into the focused input field',{text:'s'}),
T('press_button','Press home, back, recents or notifications',{button:'s'}),
T('scroll','Scroll the screen, direction up or down',{direction:'s'})
];
var DANGER=['call_phone','send_sms','reply_notification','answer_call','end_call'];
var hist=[];try{hist=JSON.parse(localStorage.getItem('h')||'[]');}catch(e){}
var busy=false,thinking=null,start=0;
function add(c,t){var d=document.createElement('div');d.className='m '+c;d.textContent=t;var ch=document.getElementById('chat');ch.appendChild(d);ch.scrollTop=ch.scrollHeight;return d;}
function save(){while(hist.length>40){hist.shift();while(hist.length&&!(hist[0].role==='user'&&typeof hist[0].content==='string'))hist.shift();}try{localStorage.setItem('h',JSON.stringify(hist));}catch(e){}}
function clearChat(){hist=[];save();document.getElementById('chat').innerHTML='';}
function setKey(){var k=prompt('अपनी API key डालिए',localStorage.getItem('k')||'');if(k!==null)localStorage.setItem('k',k.trim());}
hist.forEach(function(m){if(m.role==='user'&&typeof m.content==='string')add('u',m.content);else if(m.role==='assistant'&&Array.isArray(m.content))m.content.forEach(function(b){if(b.type==='text'&&b.text)add('a',b.text);});});
function send(){
  if(busy)return;
  var inp=document.getElementById('t');var t=inp.value.trim();
  if(!t)return;
  if(!localStorage.getItem('k')){setKey();return;}
  inp.value='';add('u',t);start=hist.length;hist.push({role:'user',content:t});busy=true;go();
}
function go(){
  thinking=add('a','सोच रहा हूँ...');
  Android.ask(localStorage.getItem('k'),JSON.stringify({model:MODEL,max_tokens:1024,system:SYSTEM,tools:TOOLS,messages:hist}));
}
function execTool(b){
  if(DANGER.indexOf(b.name)>=0){
    if(!confirm('AI यह करना चाहता है:\n'+b.name+' '+JSON.stringify(b.input)+'\n\nअनुमति दें?'))return 'यूज़र ने मना कर दिया';
  }
  add('s','⚙️ '+b.name);
  return Android.run(b.name,JSON.stringify(b.input||{}));
}
function onReply(r){
  if(thinking&&thinking.parentNode)thinking.parentNode.removeChild(thinking);
  var o;try{o=JSON.parse(r);}catch(e){o={error:{message:r}};}
  if(!o.content){
    add('a','एरर: '+(o.error?o.error.message:r));
    hist.length=start;busy=false;save();return;
  }
  hist.push({role:'assistant',content:o.content});
  var txt='';
  o.content.forEach(function(b){if(b.type==='text'&&b.text){add('a',b.text);txt+=b.text+' ';}});
  if(o.stop_reason==='tool_use'){
    var res=[];
    o.content.forEach(function(b){if(b.type==='tool_use')res.push({type:'tool_result',tool_use_id:b.id,content:String(execTool(b))});});
    hist.push({role:'user',content:res});
    go();
  }else{
    busy=false;save();
    if(txt)Android.speak(txt);
  }
}
function onSpeech(t){document.getElementById('t').value=t;send();}
document.getElementById('t').addEventListener('keydown',function(e){if(e.key==='Enter')send();});
</script>
