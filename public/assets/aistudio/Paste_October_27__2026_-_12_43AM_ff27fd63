package com.deelip.assistant;

import android.app.Notification;
import android.app.RemoteInput;
import android.content.Intent;
import android.os.Bundle;
import android.service.notification.NotificationListenerService;
import android.service.notification.StatusBarNotification;
import java.util.ArrayList;

public class NotifService extends NotificationListenerService {
    static final ArrayList<StatusBarNotification> L = new ArrayList<StatusBarNotification>();
    static NotifService I;

    @Override public void onListenerConnected() { I = this; }

    @Override public void onNotificationPosted(StatusBarNotification s) {
        if (s.getPackageName().equals(getPackageName()) || s.isOngoing()) return;
        synchronized (L) {
            L.add(s);
            while (L.size() > 20) L.remove(0);
        }
    }

    static String dump() {
        if (I == null) return "Notification access चालू नहीं है। ऊपर 🔔 बटन से चालू करें।";
        StringBuilder sb = new StringBuilder();
        synchronized (L) {
            for (int i = 0; i < L.size(); i++) {
                StatusBarNotification s = L.get(i);
                Bundle e = s.getNotification().extras;
                sb.append(i).append(". ").append(s.getPackageName()).append(" | ")
                  .append(e.getCharSequence(Notification.EXTRA_TITLE)).append(": ")
                  .append(e.getCharSequence(Notification.EXTRA_TEXT)).append("\n");
            }
        }
        return sb.length() == 0 ? "कोई नई नोटिफ़िकेशन नहीं" : sb.toString();
    }

    static String reply(int idx, String text) {
        if (I == null) return "Notification access चालू नहीं है";
        StatusBarNotification s;
        synchronized (L) {
            if (idx < 0 || idx >= L.size()) return "गलत नंबर";
            s = L.get(idx);
        }
        Notification.Action[] acts = s.getNotification().actions;
        if (acts == null) return "इसमें जवाब देने का विकल्प नहीं है";
        for (Notification.Action a : acts) {
            RemoteInput[] ris = a.getRemoteInputs();
            if (ris != null && ris.length > 0) {
                Intent in = new Intent();
                Bundle b = new Bundle();
                for (RemoteInput ri : ris) b.putCharSequence(ri.getResultKey(), text);
                RemoteInput.addResultsToIntent(ris, in, b);
                try {
                    a.actionIntent.send(I, 0, in);
                    return "जवाब भेज दिया";
                } catch (Exception e) {
                    return "एरर: " + e.getMessage();
                }
            }
        }
        return "इसमें जवाब देने का विकल्प नहीं है";
    }
}
