package com.deelip.assistant;

import android.accessibilityservice.AccessibilityService;
import android.content.Intent;
import android.os.Bundle;
import android.view.accessibility.AccessibilityEvent;
import android.view.accessibility.AccessibilityNodeInfo;
import java.util.List;

public class PhoneService extends AccessibilityService {
    static PhoneService I;

    @Override protected void onServiceConnected() { I = this; }
    @Override public boolean onUnbind(Intent i) { I = null; return super.onUnbind(i); }
    @Override public void onAccessibilityEvent(AccessibilityEvent e) {}
    @Override public void onInterrupt() {}

    static String off() { return "Accessibility सेवा चालू नहीं है। ऊपर ♿ बटन से चालू करें।"; }

    static String read() {
        if (I == null) return off();
        AccessibilityNodeInfo r = I.getRootInActiveWindow();
        if (r == null) return "स्क्रीन नहीं पढ़ पाया";
        StringBuilder sb = new StringBuilder();
        walk(r, sb);
        return sb.length() == 0 ? "स्क्रीन पर कोई टेक्स्ट नहीं मिला" : sb.toString();
    }

    static void walk(AccessibilityNodeInfo n, StringBuilder sb) {
        if (n == null || sb.length() > 3000) return;
        CharSequence t = n.getText();
        if (t == null) t = n.getContentDescription();
        if (t != null && t.length() > 0) sb.append(n.isClickable() ? "[btn] " : "").append(t).append("\n");
        for (int i = 0; i < n.getChildCount(); i++) walk(n.getChild(i), sb);
    }

    static String tap(String t) {
        if (I == null) return off();
        AccessibilityNodeInfo r = I.getRootInActiveWindow();
        if (r == null) return "स्क्रीन नहीं पढ़ पाया";
        List<AccessibilityNodeInfo> l = r.findAccessibilityNodeInfosByText(t);
        for (AccessibilityNodeInfo node : l) {
            AccessibilityNodeInfo x = node;
            while (x != null && !x.isClickable()) x = x.getParent();
            if (x != null && x.performAction(AccessibilityNodeInfo.ACTION_CLICK)) return "टैप किया: " + t;
        }
        return "स्क्रीन पर नहीं मिला: " + t;
    }

    static String type(String t) {
        if (I == null) return off();
        AccessibilityNodeInfo r = I.getRootInActiveWindow();
        if (r == null) return "स्क्रीन नहीं पढ़ पाया";
        AccessibilityNodeInfo f = r.findFocus(AccessibilityNodeInfo.FOCUS_INPUT);
        if (f == null) return "कोई टेक्स्ट बॉक्स चुना हुआ नहीं है";
        Bundle b = new Bundle();
        b.putCharSequence(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, t);
        return f.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, b) ? "टाइप किया" : "टाइप नहीं हो पाया";
    }

    static String press(String w) {
        if (I == null) return off();
        int a;
        if (w.equals("home")) a = GLOBAL_ACTION_HOME;
        else if (w.equals("back")) a = GLOBAL_ACTION_BACK;
        else if (w.equals("recents")) a = GLOBAL_ACTION_RECENTS;
        else if (w.equals("notifications")) a = GLOBAL_ACTION_NOTIFICATIONS;
        else return "बटन: home, back, recents या notifications";
        return I.performGlobalAction(a) ? "दबाया: " + w : "नहीं दबा";
    }

    static AccessibilityNodeInfo findScroll(AccessibilityNodeInfo n) {
        if (n == null) return null;
        if (n.isScrollable()) return n;
        for (int i = 0; i < n.getChildCount(); i++) {
            AccessibilityNodeInfo r = findScroll(n.getChild(i));
            if (r != null) return r;
        }
        return null;
    }

    static String scroll(String d) {
        if (I == null) return off();
        AccessibilityNodeInfo s = findScroll(I.getRootInActiveWindow());
        if (s == null) return "स्क्रॉल होने वाली चीज़ नहीं मिली";
        int a = d.equals("up") ? AccessibilityNodeInfo.ACTION_SCROLL_BACKWARD : AccessibilityNodeInfo.ACTION_SCROLL_FORWARD;
        return s.performAction(a) ? "स्क्रॉल किया" : "स्क्रॉल नहीं हुआ";
    }
}
